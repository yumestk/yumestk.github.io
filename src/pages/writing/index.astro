---
import SiteLayout from '../../layouts/SiteLayout.astro'
import PostList from '../../components/PostList.astro'
import { getPosts } from '../../data/site'
const posts = await getPosts()
const description = 'Notes on code, life, and everything in between.'
const filters = [
  { value: 'all', label: 'All' },
  { value: 'articles', label: 'Articles' },
  { value: 'weekly', label: 'Weekly' },
]
---
<SiteLayout title="Writing" section="writing" {description}>
  <header class="page-heading">
    <h1>Writing</h1>
    <p>{description}</p>
  </header>
  <div class="writing-archive">
    <fieldset class="writing-filters">
      <legend class="sr-only">Filter writing</legend>
      {filters.map(({ value, label }) => (
        <label>
          <input class="sr-only" type="radio" name="writing-filter" value={value} checked={value === 'all'} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>
    <PostList {posts} showDescription />
  </div>
</SiteLayout>
