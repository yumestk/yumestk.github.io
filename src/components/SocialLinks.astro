---
import { GitFork, Mail } from '@lucide/astro'
import { socials } from '../data/site'
---
<ul class="social-links flex flex-wrap gap-2" aria-label="Social links">
  <li><a href={socials.github}><GitFork size={16} aria-hidden="true" /> GitHub</a></li>
  <li><a href={socials.x}><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-7.4L5.5 22H2.3l7.3-8.4L1.8 2h6.5l4.5 6.9L18.9 2Zm-1.1 18h1.8L7.3 3.9H5.4L17.8 20Z"/></svg> X</a></li>
  <li><a href={`mailto:${socials.email}`}><Mail size={16} aria-hidden="true" /> Email</a></li>
</ul>
