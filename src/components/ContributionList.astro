---
import { GitPullRequest } from '@lucide/astro'
import { contributions } from '../data/site'
const { limit = contributions.length } = Astro.props
---
<ul class="list-rows">
  {contributions.slice(0, limit).map((item) => (
    <li>
      <a href={item.url} class="contribution-row">
        <GitPullRequest size={18} aria-hidden="true" />
        <div><p class="row-title">{item.title}</p><p class="metadata">{item.repo} #{item.number}{limit === contributions.length && ` · ${item.stack.join(' · ')}`}</p></div>
        <span class="contribution-label">Merged</span>
      </a>
    </li>
  ))}
</ul>
